OPENAI_API_KEY=your_openai_api_key_here
# Credentials should belong to a read-only PostgreSQL role with SELECT access.
DATABASE_URL=postgresql+psycopg2://readonly_user:replace_me@localhost:5432/SpatialBenchmark
# Optional alternative for multi-database deployments:
# POSTGIS_DATABASE_URL_TEMPLATE=postgresql+psycopg2://readonly_user:replace_me@localhost:5432/{database}
POSTGIS_AGENT_MODEL=gpt-5.6-luna
POSTGIS_EXPERIENCE_ENABLED=false
MAX_MAP_FEATURES=5000
